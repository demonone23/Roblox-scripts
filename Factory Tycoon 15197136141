-- Money-per-second rolling tracker (5 second window)
local moneyHistory = {}
local lastMPS = 0

local function getMPS()
    local dataFolder = LocalPlayer:FindFirstChild("DataFolder")
    local moneyObj = dataFolder and dataFolder:FindFirstChild("Money")
    if not moneyObj then return lastMPS end
    local now = tick()
    table.insert(moneyHistory, { t = now, v = math.floor(moneyObj.Value) })
    while #moneyHistory > 0 and now - moneyHistory[1].t > 5 do
        table.remove(moneyHistory, 1)
    end
    if #moneyHistory < 2 then return lastMPS end
    -- sum only positive deltas so purchases don't corrupt the income rate
    local totalIncome = 0
    local dt = moneyHistory[#moneyHistory].t - moneyHistory[1].t
    for i = 2, #moneyHistory do
        local delta = moneyHistory[i].v - moneyHistory[i - 1].v
        if delta > 0 then totalIncome = totalIncome + delta end
    end
    if dt <= 0 then return lastMPS end
    lastMPS = totalIncome / dt
    return lastMPS
end

local function formatTime(secs)
    if secs <= 0 or secs ~= secs then return "now" end
    if secs < 60 then return string.format("%.0fs", secs) end
    if secs < 3600 then return string.format("%.0fm %.0fs", math.floor(secs / 60), secs % 60) end
    return string.format("%.0fh %.0fm", math.floor(secs / 3600), math.floor((secs % 3600) / 60))
end

Tab:CreateToggle({
    Name = "Auto Buy",
    CurrentValue = false,
    Flag = "AutoBuy",
    Callback = function(enabled)
        autoBuyActive = enabled
        if enabled then
            task.spawn(function()
                while autoBuyActive do
                    pcall(function()
                        local character = LocalPlayer.Character
                        if not character then return end
                        local hrp = character:FindFirstChild("HumanoidRootPart")
                        if not hrp then return end

                        local dataFolder = LocalPlayer:FindFirstChild("DataFolder")
                        local moneyObj = dataFolder and dataFolder:FindFirstChild("Money")
                        local currentMoney = moneyObj and math.floor(moneyObj.Value) or 0

                        local buttons = getTycoon():WaitForChild("Buttons")

                        local nextTarget = nil
                        local nextPrice = math.huge
                        local nextPart = nil
                        local affordable = {}

                        local rebirths = (LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Rebirths") and LocalPlayer.leaderstats.Rebirths.Value) or 0

                        for _, button in ipairs(buttons:GetChildren()) do
                            pcall(function()
                                local btnFolder = button:FindFirstChild("Button")
                                local part = btnFolder and btnFolder:FindFirstChild("Part")
                                if not part then return end

                                local visibleObj = button:FindFirstChild("IsButtonVisible")
                                if not visibleObj or not visibleObj.Value then return end

                                local rebirthPriceObj = button:FindFirstChild("RebirthPrice")
                                local priceObj = button:FindFirstChild("Price")

                                if rebirthPriceObj then
                                    local rPrice = math.floor(rebirthPriceObj.Value)
                                    if rebirths >= rPrice then
                                        table.insert(affordable, { part = part, price = 0, name = button.Name })
                                    elseif rPrice < nextPrice then
                                        nextPrice = rPrice
                                        nextTarget = button.Name .. " (" .. rPrice .. " rebirths)"
                                        nextPart = part
                                    end
                                elseif priceObj then
                                    local price = math.floor(priceObj.Value)
                                    if currentMoney >= price then
                                        table.insert(affordable, { part = part, price = price, name = button.Name })
                                    elseif price < nextPrice then
                                        nextPrice = price
                                        nextTarget = button.Name
                                        nextPart = part
                                    end
                                end
                            end)
                        end

                        -- buy only the cheapest affordable button this tick
                        table.sort(affordable, function(a, b) return a.price < b.price end)
                        if #affordable > 0 then
                            firetouchinterest(affordable[1].part, hrp, 0)
                        end

                        -- green highlight = cheapest thing being bought right now
                        buyingHighlight.Adornee = (#affordable > 0) and affordable[1].part or nil
                        -- yellow highlight = next unaffordable target
                        nextHighlight.Adornee = nextPart
                    end)
                    task.wait(0.1)
                end
            end)
        else
            buyingHighlight.Adornee = nil
            nextHighlight.Adornee = nil
        end
    end,
})

autoBuyStatus = Tab:CreateParagraph({ Title = "Auto Buy Status", Content = "Scanning..." })

-- Always-running status loop (independent of toggle)
task.spawn(function()
    while true do
        pcall(function()
            local dataFolder = LocalPlayer:FindFirstChild("DataFolder")
            local moneyObj = dataFolder and dataFolder:FindFirstChild("Money")
            local currentMoney = moneyObj and math.floor(moneyObj.Value) or 0

            local nextTarget = nil
            local nextPrice = math.huge
            local cheapestAffordable = nil

            local rebirths = (LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Rebirths") and LocalPlayer.leaderstats.Rebirths.Value) or 0

            local buttons = getTycoon():WaitForChild("Buttons")
            for _, button in ipairs(buttons:GetChildren()) do
                pcall(function()
                    local btnFolder = button:FindFirstChild("Button")
                    local part = btnFolder and btnFolder:FindFirstChild("Part")
                    if not part then return end
                    local visibleObj = button:FindFirstChild("IsButtonVisible")
                    if not visibleObj or not visibleObj.Value then return end

                    local rebirthPriceObj = button:FindFirstChild("RebirthPrice")
                    local priceObj = button:FindFirstChild("Price")

                    if rebirthPriceObj then
                        local rPrice = math.floor(rebirthPriceObj.Value)
                        if rebirths >= rPrice then
                            if cheapestAffordable == nil then
                                cheapestAffordable = { name = button.Name, price = 0, label = button.Name .. " (rebirth)" }
                            end
                        elseif rPrice < nextPrice then
                            nextPrice = rPrice
                            nextTarget = button.Name .. " (" .. rPrice .. " rebirths)"
                        end
                    elseif priceObj then
                        local price = math.floor(priceObj.Value)
                        if currentMoney >= price then
                            if cheapestAffordable == nil or price < cheapestAffordable.price then
                                cheapestAffordable = { name = button.Name, price = price, label = button.Name .. " ($" .. price .. ")" }
                            end
                        elseif price < nextPrice then
                            nextPrice = price
                            nextTarget = button.Name
                        end
                    end
                end)
            end

            local mps = getMPS()
            local buying = cheapestAffordable and ("Buying: " .. (cheapestAffordable.label or cheapestAffordable.name) .. "\n") or ""
            local statusContent
            if nextTarget then
                local needed = nextPrice - currentMoney
                local eta = mps > 0 and (needed / mps) or math.huge
                statusContent = buying .. string.format(
                    "Next: %s\nPrice: $%d | Need: $%d\nMPS: $%.1f/s | ETA: %s",
                    nextTarget, nextPrice, math.max(0, needed), mps, formatTime(eta)
                )
            elseif cheapestAffordable then
                statusContent = buying .. string.format("MPS: $%.1f/s", mps)
            else
                statusContent = string.format("All buttons purchased!\nMPS: $%.1f/s", mps)
            end
            autoBuyStatus:Set({ Title = "Auto Buy Status", Content = statusContent })
        end)
        task.wait(0.5)
    end
end)
