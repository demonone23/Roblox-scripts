-- Helper: get the player's tycoon folder dynamically
local function getTycoon()
    local tycoonOwned = LocalPlayer:WaitForChild("TycoonOwned")
    -- ObjectValue → .Value is the folder itself; StringValue → look it up by name
    if typeof(tycoonOwned.Value) == "Instance" then
        return tycoonOwned.Value
    end
    return workspace:WaitForChild("Tycoons"):WaitForChild(tycoonOwned.Value)
end

