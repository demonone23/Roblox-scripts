-- Tests: strings, numbers, tables, metatables, closures, coroutines,
--        varargs, OOP, pcall, bit ops, patterns, upvalues, goto, rawget/rawset

local PASS, FAIL = 0, 0
local function check(label, cond)
	if cond then
		print("[PASS] " .. label)
		PASS = PASS + 1
	else
		print("[FAIL] " .. label)
		FAIL = FAIL + 1
	end
end

