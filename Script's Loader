local placeScripts = {
    [110626257954132] = "https://gate.sirius.menu/gateway?id=sid_3uf47jwjfd1b",
    [130551215074851] = "https://gate.sirius.menu/gateway?id=sid_t4rdodeo8f6z",
}

local defaultScript = nil

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local httpRequest = (syn and syn.request) or http_request or request

local function fetchUrl(url)
    local placeId = game.PlaceId
    local userId = Players.LocalPlayer and Players.LocalPlayer.UserId or 0

    -- append identifiers that gateways typically require
    local fullUrl = url
        .. "&placeid=" .. placeId
        .. "&userid=" .. userId

    local res = httpRequest({
        Url = fullUrl,
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Roblox/WinInet",
            ["Accept"] = "*/*",
        },
    })

    if not res then
        return false, "No response from server"
    end

    if res.StatusCode ~= 200 then
        -- print body so you can see the actual server error message
        print("[scripthub] Server response body: " .. tostring(res.Body))
        return false, "HTTP " .. tostring(res.StatusCode)
    end

    if not res.Body or res.Body == "" then
        return false, "Empty response body"
    end

    return true, res.Body
end

local function loadFromUrl(url)
    local ok, body = fetchUrl(url)
    if not ok then
        return false, body
    end

    local fn, compileErr = loadstring(body)
    if not fn then
        return false, "Compile error: " .. tostring(compileErr)
    end

    local runOk, runErr = pcall(fn)
    if not runOk then
        return false, "Runtime error: " .. tostring(runErr)
    end

    return true, nil
end

local placeId = game.PlaceId
local url = placeScripts[placeId] or defaultScript

if url then
    local success, err = loadFromUrl(url)
    if not success then
        warn(("[scripthub] Place %d — %s"):format(placeId, err))
    end
else
    warn(("[scripthub] No script configured for place %d"):format(placeId))
end
