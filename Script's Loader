-- 15. OOP: INHERITANCE
-- ══════════════════════════════════════════════
local Animal = {}
Animal.__index = Animal
function Animal.new(name, sound)
	return setmetatable({name=name, sound=sound, hp=100}, Animal)
end
function Animal:speak() return self.name .. " says " .. self.sound end
function Animal:damage(n) self.hp = self.hp - n end
function Animal:alive() return self.hp > 0 end

local Dog = setmetatable({}, {__index = Animal})
Dog.__index = Dog
function Dog.new(name)
	local self = Animal.new(name, "Woof")
	return setmetatable(self, Dog)
end
function Dog:fetch(item) return self.name .. " fetches " .. item end

local GoldenRetriever = setmetatable({}, {__index = Dog})
GoldenRetriever.__index = GoldenRetriever
function GoldenRetriever.new(name)
	local self = Dog.new(name)
	return setmetatable(self, GoldenRetriever)
end
function GoldenRetriever:describe() return "Golden: " .. self.name end

local d = Dog.new("Rex")
local g = GoldenRetriever.new("Buddy")
d:damage(30)

check("OOP speak",        d:speak() == "Rex says Woof")
check("OOP fetch",        d:fetch("ball") == "Rex fetches ball")
check("OOP damage",       d.hp == 70)
check("OOP alive",        d:alive())
check("OOP 3-level speak",g:speak() == "Buddy says Woof")
check("OOP 3-level desc", g:describe() == "Golden: Buddy")
check("instanceof-ish",   getmetatable(g) == GoldenRetriever)

