-- ══════════════════════════════════════════════
-- 4. METATABLES & METAMETHODS
-- ══════════════════════════════════════════════
local Vec = {}
Vec.__index = Vec
Vec.__add = function(a, b) return setmetatable({x=a.x+b.x, y=a.y+b.y}, getmetatable(a)) end
Vec.__sub = function(a, b) return setmetatable({x=a.x-b.x, y=a.y-b.y}, getmetatable(a)) end
Vec.__mul = function(a, s) return setmetatable({x=a.x*s, y=a.y*s}, getmetatable(a)) end
Vec.__eq  = function(a, b) return a.x==b.x and a.y==b.y end
Vec.__lt  = function(a, b) return (a.x^2+a.y^2) < (b.x^2+b.y^2) end
Vec.__le  = function(a, b) return (a.x^2+a.y^2) <= (b.x^2+b.y^2) end
Vec.__tostring = function(v) return "("..v.x..","..v.y..")" end
Vec.__concat = function(a, b) return tostring(a)..tostring(b) end
Vec.__len = function(v) return math.sqrt(v.x^2+v.y^2) end
Vec.__unm = function(v) return setmetatable({x=-v.x, y=-v.y}, getmetatable(v)) end
Vec.__call = function(v, s) return setmetatable({x=v.x*s, y=v.y*s}, getmetatable(v)) end

function Vec.new(x, y) return setmetatable({x=x, y=y}, Vec) end
function Vec:dot(other) return self.x*other.x + self.y*other.y end
function Vec:len() return math.sqrt(self.x^2+self.y^2) end

local v1 = Vec.new(3, 4)
local v2 = Vec.new(1, 2)
local v3 = v1 + v2
local v4 = -v1
local v5 = v1(2)   -- __call

check("__add",       v3.x == 4 and v3.y == 6)
check("__sub",       (v1 - v2).x == 2)
check("__mul",       (v1 * 2).x == 6)
check("__unm",       v4.x == -3 and v4.y == -4)
check("__call",      v5.x == 6 and v5.y == 8)
check("__len",       #v1 == 5)
check("__eq",        Vec.new(1,2) == Vec.new(1,2))
check("__lt",        v2 < v1)
check("__le",        v2 <= v1)
check("__tostring",  tostring(v1) == "(3,4)")
check("__index method", v1:dot(v2) == 11)
check("__newindex", (function()
	local log = {}
	local proxy = setmetatable({}, {
		__newindex = function(t, k, v) log[#log+1] = k; rawset(t, k, v) end,
		__index = rawget
	})
	proxy.a = 1
	proxy.b = 2
	return #log == 2 and log[1] == "a"
end)())

