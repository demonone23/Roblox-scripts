-- 8. COROUTINES
-- ══════════════════════════════════════════════
local co = coroutine.create(function(a, b)
	local sum = a + b
	local c = coroutine.yield(sum)
	coroutine.yield(c * 2)
	return "done"
end)

local ok1, v1c = coroutine.resume(co, 3, 4)
local ok2, v2c = coroutine.resume(co, 10)
local ok3, v3c = coroutine.resume(co)
local ok4, v4c = coroutine.resume(co)  -- dead

check("coroutine yield 1",   ok1 and v1c == 7)
check("coroutine yield 2",   ok2 and v2c == 20)
check("coroutine return",    ok3 and v3c == "done")
check("coroutine dead",      not ok4)
check("coroutine status",    coroutine.status(co) == "dead")

local gen = coroutine.wrap(function()
	for i = 1, 5 do coroutine.yield(i) end
end)
local gsum = 0
for i = 1, 5 do gsum = gsum + gen() end
check("coroutine wrap sum",  gsum == 15)

-- producer/consumer via coroutine
local function producer(items)
	return coroutine.wrap(function()
		for _, v in ipairs(items) do
			coroutine.yield(v)
		end
	end)
end
local collected = {}
for v in producer({10,20,30,40}) do collected[#collected+1] = v end
check("coroutine iterator", #collected == 4 and collected[3] == 30)

