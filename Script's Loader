local function sum(...)
	local args = {...}
	local n = select("#", ...)
	local s = 0
	for i = 1, n do s = s + args[i] end
	return s
end

local function passThrough(...)
	return ...
end

local function countArgs(...)
	return select("#", ...)
end

local function tablepack(...)
	return table.pack(...)
end

check("vararg sum",        sum(1,2,3,4,5) == 15)
check("vararg passthrough",(function() local a,b,c = passThrough(7,8,9); return a+b+c end)() == 24)
check("select # with nil", countArgs(1, nil, 3) == 3)
check("table.pack n",      tablepack(10,20,30).n == 3)

local function firstLast(...)
	local t = {...}
	return t[1], t[#t]
end
local fa, fb = firstLast(5,6,7,8)
check("first/last vararg", fa == 5 and fb == 8)

