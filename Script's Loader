-- 16. RECURSION
-- ══════════════════════════════════════════════
local function fib(n)
	if n <= 1 then return n end
	return fib(n-1) + fib(n-2)
end
check("fibonacci",  fib(10) == 55)

local function fact(n)
	return n <= 1 and 1 or n * fact(n-1)
end
check("factorial",  fact(10) == 3628800)

-- mutual recursion
local isEven, isOdd
isEven = function(n) return n == 0 or isOdd(n-1) end
isOdd  = function(n) return n ~= 0 and isEven(n-1) end
check("mutual recursion even", isEven(100))
check("mutual recursion odd",  isOdd(99))

-- memoized
local memo = {}
local function mfib(n)
	if memo[n] then return memo[n] end
	if n <= 1 then memo[n] = n; return n end
	memo[n] = mfib(n-1) + mfib(n-2)
	return memo[n]
end
check("memoized fib(30)", mfib(30) == 832040)

