-- 5. CLOSURES & UPVALUES
-- ══════════════════════════════════════════════
local function makeCounter(start, step)
	local n = start
	return {
		inc = function() n = n + step; return n end,
		dec = function() n = n - step; return n end,
		get = function() return n end,
		reset = function() n = start end,
	}
end

local c = makeCounter(10, 3)
check("closure upvalue inc", c.inc() == 13)
check("closure upvalue inc2",c.inc() == 16)
check("closure upvalue dec", c.dec() == 13)
check("closure reset",       (function() c.reset(); return c.get() end)() == 10)

local function adder(x)
	return function(y)
		return function(z)
			return x + y + z
		end
	end
end
check("triple closure",  adder(1)(2)(3) == 6)

-- shared upvalue
local function sharedUp()
	local x = 0
	local function a() x = x + 1 end
	local function b() x = x + 10 end
	local function g() return x end
	return a, b, g
end
local ua, ub, ug = sharedUp()
ua(); ua(); ub()
check("shared upvalue",  ug() == 12)

