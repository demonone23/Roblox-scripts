-- 22. ITERATORS (custom stateful & stateless)
-- ══════════════════════════════════════════════
-- stateless
local function range(n)
	return function(_, i)
		i = i + 1
		if i <= n then return i end
	end, nil, 0
end

local rsum = 0
for i in range(10) do rsum = rsum + i end
check("custom stateless iter", rsum == 55)

-- stateful closure iterator
local function fibiter(max)
	local a, b = 0, 1
	return function()
		if a > max then return nil end
		local v = a
		a, b = b, a+b
		return v
	end
end

local fibs = {}
for v in fibiter(20) do fibs[#fibs+1] = v end
check("fibonacci iterator", fibs[7] == 8 and fibs[8] == 13)

-- ipairs stops at nil
