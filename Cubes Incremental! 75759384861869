-- ─── Runes Tab ──────────────────────────────────────────────────────────────
local runeEvent = ReplicatedStorage
    .Packages
    ._Index["sleitnick_knit@1.7.0"]
    .knit.Services.RunesService.RE.BuyRune

-- Dynamically grab rune names from the buttons folder
local function getRuneOptions()
    local scripted = workspace:FindFirstChild("__Scripted")
    local runesFolder = scripted and scripted:FindFirstChild("__RunesButtons")
    local options = {}
    if runesFolder then
        for _, child in ipairs(runesFolder:GetChildren()) do
            table.insert(options, child.Name)
        end
    end
    if #options == 0 then
        options = { "Basic" } -- fallback
    end
    return options
end

local runeOptions = getRuneOptions()

local RunesTab = Window:CreateTab("Runes", 4483362458)

local selectedRune = runeOptions[1]
local runeWorkers = 5
local runeWait = 0.01
local runeRunning = false
local runeThreads = {}

local function stopRuneWorkers()
    runeRunning = false
    for _, t in ipairs(runeThreads) do
        task.cancel(t)
    end
    runeThreads = {}
end

local function startRuneWorkers()
    runeRunning = true
    for i = 1, runeWorkers do
        runeThreads[i] = task.spawn(function()
            while runeRunning do
                runeEvent:FireServer(selectedRune)
                task.wait(runeWait)
            end
        end)
    end
end

RunesTab:CreateSection("Rune Buyer")

RunesTab:CreateDropdown({
    Name = "Select Rune",
    Options = runeOptions,
    CurrentOption = { runeOptions[1] },
    Flag = "SelectedRune",
    Callback = function(option)
        selectedRune = option[1] or option
    end,
})

RunesTab:CreateSlider({
    Name = "Workers",
    Range = { 1, 50 },
    Increment = 1,
    CurrentValue = 5,
    Flag = "RuneWorkers",
    Callback = function(value)
        runeWorkers = value
        -- restart if already running
        if runeRunning then
            stopRuneWorkers()
            startRuneWorkers()
        end
    end,
})

RunesTab:CreateSlider({
    Name = "Wait (seconds)",
    Range = { 0.01, 5 },
    Increment = 0.01,
    CurrentValue = 0.01,
    Flag = "RuneWait",
    Callback = function(value)
        runeWait = value
    end,
})

RunesTab:CreateToggle({
    Name = "Auto Buy Rune",
    CurrentValue = false,
    Flag = "AutoRune",
    Callback = function(enabled)
        if enabled then
            startRuneWorkers()
        else
            stopRuneWorkers()
        end
    end,
})
