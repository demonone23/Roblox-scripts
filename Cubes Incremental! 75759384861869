-- ─── Main Tab ───────────────────────────────────────────────────────────────
local cubeEvent = ReplicatedStorage
    .Packages
    ._Index["sleitnick_knit@1.7.0"]
    .knit.Services.CubesService.RE.CollectCube

local seenUUIDs = {}
local collectMethod = "Remote"
local cubeDelay = 0.5

local function collectAllCubes()
    local scripted = workspace:FindFirstChild("__Scripted")
    local cubesFolder = scripted and scripted:FindFirstChild("__ClientCubes")
    if not cubesFolder then return end

    for _, cube in ipairs(cubesFolder:GetChildren()) do
        if collectMethod == "Remote" then
            local uuid = cube:GetAttribute("UUID")
            if uuid and not seenUUIDs[uuid] then
                seenUUIDs[uuid] = true
                cubeEvent:FireServer(uuid)
            end
        elseif collectMethod == "Size" then
            for _, part in ipairs(cube:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Size = Vector3.new(2048, 2048, 2048)
                end
            end
        end

        task.wait(cubeDelay)
    end
end

local MainTab = Window:CreateTab("Main", 4483362458)

local cubeRunning = false
