MainTab:CreateSection("Collect Methods")

MainTab:CreateDropdown({
    Name = "Method",
    Options = { "Remote", "Size" },
    CurrentOption = { "Remote" },
    Flag = "CollectMethod",
    Callback = function(option)
        collectMethod = option[1] or option
    end,
})

MainTab:CreateSlider({
    Name = "Delay per Cube (seconds)",
    Range = { 0.05, 3 },
    Increment = 0.05,
    CurrentValue = 0.5,
    Flag = "CubeDelay",
    Callback = function(value)
        cubeDelay = value
    end,
})

MainTab:CreateSection("Auto Collect")

MainTab:CreateToggle({
    Name = "Auto Collect",
    CurrentValue = false,
    Flag = "AutoCollect",
    Callback = function(enabled)
        cubeRunning = enabled
        if enabled then
            cubeThread = task.spawn(function()
                while cubeRunning do
                    collectAllCubes()
                    task.wait()
                end
            end)
        else
            if cubeThread then
                task.cancel(cubeThread)
                cubeThread = nil
            end
        end
    end,
})

